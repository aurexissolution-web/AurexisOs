# ── Supabase ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Groq (Ask Aurexis chat — /solutions HeroChat + the sitewide widget) ──
# From console.groq.com/keys. Required for /api/ai; the chat returns a 503
# "AI service is not configured" response when unset.
GROQ_API_KEY=your-groq-api-key
# Optional — defaults to openai/gpt-oss-120b when unset. Check the current
# catalog at console.groq.com/docs/models before changing; Groq deprecates
# model ids over time.
GROQ_MODEL=openai/gpt-oss-120b

# ── Telegram Bot (for contact form notifications) ───────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── Resend (calculator + Presence quote-request confirmation emails) ────
RESEND_API_KEY=your-resend-api-key
LEAD_NOTIFICATION_EMAIL=contact@aurexissolution.com
LEAD_FROM_EMAIL=Aurexis Leads <onboarding@resend.dev>

# ── Calculator lead capture ─────────────────────────────────────
# Google Apps Script Web App URL that appends rows to a Google Sheet.
# Setup: create a Sheet → Extensions → Apps Script → paste a doPost(e) handler
# that appends e.postData.contents to the sheet → Deploy → Web App
# (Execute as: Me, Who has access: Anyone) → paste deployment URL here.
# If unset, leads are still validated and logged to the server console.
GOOGLE_SHEETS_WEBHOOK_URL=

# WhatsApp number for the post-submit "Talk to us now" CTA.
# International format, no plus sign or spaces (e.g., 60123456789).
NEXT_PUBLIC_AUREXIS_WHATSAPP=60164071129

# ── Digital founder card (/sanjay) ──────────────────────────────
# Canonical production origin (non-www). Used for every absolute URL on the
# card: metadata, JSON-LD, vCard and sharing. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://aurexissolution.com

# Booking destination for the "Book a Discovery Call" CTA.
# If empty, falls back to https://cal.com/aurexis-solution/discoverycall.
NEXT_PUBLIC_FOUNDER_BOOKING_URL=

# Sanjay's personal LinkedIn profile. When set, the LinkedIn action shows
# "Sanjay Gunabalan"; when empty it falls back to the Aurexis company page.
NEXT_PUBLIC_FOUNDER_LINKEDIN_URL=

# Optional Google Analytics measurement ID (e.g. G-XXXXXXX). Analytics events are
# no-ops when unset — the card works without it.
NEXT_PUBLIC_GA_ID=
